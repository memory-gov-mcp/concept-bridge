{
  "$defs": {
    "ActionRef": {
      "additionalProperties": false,
      "description": "机制里的动作。action_class 只能取 12 类之一。",
      "properties": {
        "action_class": {
          "enum": [
            "inhibit",
            "promote",
            "transport",
            "transform",
            "recognize",
            "amplify",
            "stabilize",
            "degrade",
            "compete",
            "isolate",
            "trigger",
            "regulate"
          ],
          "title": "Action Class",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "promote",
            "inhibit",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "verb": {
          "minLength": 1,
          "title": "Verb",
          "type": "string"
        }
      },
      "required": [
        "verb",
        "action_class",
        "polarity"
      ],
      "title": "ActionRef",
      "type": "object"
    },
    "Bridge": {
      "additionalProperties": false,
      "description": "一条跨域桥：目标机制 + 为什么能对上 + 能迁移什么。",
      "properties": {
        "alignment": {
          "items": {
            "$ref": "#/$defs/RoleAlignment"
          },
          "title": "Alignment",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "differences": {
          "items": {
            "type": "string"
          },
          "title": "Differences",
          "type": "array"
        },
        "scores": {
          "$ref": "#/$defs/BridgeScores"
        },
        "target_domain": {
          "minLength": 1,
          "title": "Target Domain",
          "type": "string"
        },
        "target_mechanism": {
          "$ref": "#/$defs/MechanismUnit"
        },
        "transferable_hypothesis": {
          "minLength": 1,
          "title": "Transferable Hypothesis",
          "type": "string"
        }
      },
      "required": [
        "target_mechanism",
        "target_domain",
        "scores",
        "transferable_hypothesis",
        "citations"
      ],
      "title": "Bridge",
      "type": "object"
    },
    "BridgeScores": {
      "additionalProperties": false,
      "properties": {
        "domain_distance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Domain Distance",
          "type": "number"
        },
        "final": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final",
          "type": "number"
        },
        "semantic": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic",
          "type": "number"
        },
        "structural": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Structural",
          "type": "number"
        },
        "triviality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Triviality",
          "type": "number"
        }
      },
      "required": [
        "structural",
        "semantic",
        "domain_distance",
        "triviality",
        "final"
      ],
      "title": "BridgeScores",
      "type": "object"
    },
    "BridgeSource": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "mechanisms": {
          "items": {
            "$ref": "#/$defs/MechanismUnit"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "subgraph": {
          "$ref": "#/$defs/Subgraph"
        }
      },
      "required": [
        "domain"
      ],
      "title": "BridgeSource",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "paper_id": {
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "span": {
          "minLength": 1,
          "title": "Span",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "span",
        "char_start",
        "char_end"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ConceptRef": {
      "additionalProperties": false,
      "description": "机制里的一个实体。concept_id 是归一后的 ID，surface 是原文写法。",
      "properties": {
        "concept_id": {
          "minLength": 1,
          "title": "Concept Id",
          "type": "string"
        },
        "surface": {
          "minLength": 1,
          "title": "Surface",
          "type": "string"
        },
        "type": {
          "enum": [
            "structure",
            "process",
            "substance",
            "signal",
            "state"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "concept_id",
        "surface",
        "type"
      ],
      "title": "ConceptRef",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "原文证据。前端点击引用时按 char_start/char_end 高亮。",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "section": {
          "default": "abstract",
          "enum": [
            "abstract",
            "intro",
            "results",
            "discussion",
            "conclusion",
            "unknown"
          ],
          "title": "Section",
          "type": "string"
        },
        "span": {
          "minLength": 1,
          "title": "Span",
          "type": "string"
        }
      },
      "required": [
        "span",
        "char_start",
        "char_end"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "action_class": {
          "enum": [
            "inhibit",
            "promote",
            "transport",
            "transform",
            "recognize",
            "amplify",
            "stabilize",
            "degrade",
            "compete",
            "isolate",
            "trigger",
            "regulate"
          ],
          "title": "Action Class",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "action_class"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "structure",
            "process",
            "substance",
            "signal",
            "state"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "domain",
        "type"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "MechanismUnit": {
      "additionalProperties": false,
      "description": "系统的原子单位：一个可比较的机制。",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionRef"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "extractor_version": {
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/ConceptRef"
        },
        "paper_id": {
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "result": {
          "minLength": 1,
          "title": "Result",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/StructuralSignature"
        },
        "subject": {
          "$ref": "#/$defs/ConceptRef"
        }
      },
      "required": [
        "id",
        "paper_id",
        "domain",
        "subject",
        "action",
        "object",
        "result",
        "signature",
        "evidence",
        "confidence",
        "extractor_version"
      ],
      "title": "MechanismUnit",
      "type": "object"
    },
    "ResultMeta": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "graph_version": {
          "minLength": 1,
          "title": "Graph Version",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "stub": {
          "default": false,
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "latency_ms",
        "candidates",
        "graph_version"
      ],
      "title": "ResultMeta",
      "type": "object"
    },
    "RoleAlignment": {
      "additionalProperties": false,
      "description": "一个桥的节点级对应关系，前端用它做对齐高亮。",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_concept_id": {
          "minLength": 1,
          "title": "Source Concept Id",
          "type": "string"
        },
        "source_role": {
          "enum": [
            "subject",
            "object"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "target_concept_id": {
          "minLength": 1,
          "title": "Target Concept Id",
          "type": "string"
        },
        "target_role": {
          "enum": [
            "subject",
            "object"
          ],
          "title": "Target Role",
          "type": "string"
        }
      },
      "required": [
        "source_role",
        "source_concept_id",
        "target_role",
        "target_concept_id",
        "reason"
      ],
      "title": "RoleAlignment",
      "type": "object"
    },
    "StructuralSignature": {
      "additionalProperties": false,
      "description": "结构签名——本项目\"结构相似而非文字相似\"的载体。",
      "properties": {
        "action_class": {
          "enum": [
            "inhibit",
            "promote",
            "transport",
            "transform",
            "recognize",
            "amplify",
            "stabilize",
            "degrade",
            "compete",
            "isolate",
            "trigger",
            "regulate"
          ],
          "title": "Action Class",
          "type": "string"
        },
        "arity": {
          "maximum": 8,
          "minimum": 2,
          "title": "Arity",
          "type": "integer"
        },
        "causality": {
          "enum": [
            "direct",
            "mediated",
            "feedback",
            "threshold"
          ],
          "title": "Causality",
          "type": "string"
        },
        "condition_count": {
          "minimum": 0,
          "title": "Condition Count",
          "type": "integer"
        },
        "condition_keys": {
          "items": {
            "type": "string"
          },
          "title": "Condition Keys",
          "type": "array"
        },
        "object_type": {
          "enum": [
            "structure",
            "process",
            "substance",
            "signal",
            "state"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "promote",
            "inhibit",
            "neutral"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "subject_type": {
          "enum": [
            "structure",
            "process",
            "substance",
            "signal",
            "state"
          ],
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "subject_type",
        "action_class",
        "object_type",
        "causality",
        "polarity",
        "condition_count",
        "arity"
      ],
      "title": "StructuralSignature",
      "type": "object"
    },
    "Subgraph": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "title": "Subgraph",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "POST /api/v1/bridge 的返回，也是前端唯一数据源。",
  "properties": {
    "bridges": {
      "items": {
        "$ref": "#/$defs/Bridge"
      },
      "title": "Bridges",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ResultMeta"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/BridgeSource"
    }
  },
  "required": [
    "query",
    "source",
    "meta"
  ],
  "title": "BridgeResult",
  "type": "object"
}
