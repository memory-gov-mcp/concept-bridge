# 复制为 .env 后填写。除 LLM_API_KEY 外都有默认值。
OPENALEX_MAILTO=team@example.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBED_MODEL=intfloat/multilingual-e5-large
DATA_DIR=./data

# DEMO_MODE=1：冻结图谱到预置样例，且禁外网。用于"绝不翻车"的现场演示。
DEMO_MODE=0
# LLM_OFFLINE=1：仍用真实语料图谱，但禁止任何 LLM 外网请求（只读缓存）。
# `uv run task demo --corpus` 会自动设置它。
LLM_OFFLINE=0

TOP_K=5
BRIDGE_TIMEOUT_S=15
LOG_LEVEL=INFO
